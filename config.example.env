# leetcode-daily configuration. Keep this file private (install.sh makes it chmod 600).

# --- LeetCode login ---------------------------------------------------------
# LeetCode blocks scripted password logins with a CAPTCHA, so this reuses your
# browser's login instead. While logged in to leetcode.com in your browser:
#   Zen/Firefox: F12 -> Storage -> Cookies -> https://leetcode.com
#   Chromium:    F12 -> Application -> Cookies -> https://leetcode.com
# and copy the values of the LEETCODE_SESSION and csrftoken cookies.
# They last for weeks; you'll get a desktop notification when they expire.
LEETCODE_SESSION=
LEETCODE_CSRFTOKEN=

# --- Local model (Ollama) ---------------------------------------------------
OLLAMA_URL=http://localhost:11434
# Any model you've pulled with `ollama pull`. Models with a reasoning mode
# (qwen3, deepseek-r1) do best; others work too, just without reasoning.
MODEL=qwen3:8b

# --- Behaviour --------------------------------------------------------------
# Try a published solution from public GitHub collections (doocs/leetcode,
# walkccc/LeetCode) before asking the model. The model takes over if none is
# found or it fails.
ONLINE_LOOKUP=true
# Language slug as LeetCode names it: python3, cpp, java, javascript, typescript, golang, rust, ...
LANGUAGE=python3
# Problems to solve per day
DAILY_COUNT=2
# Attempts per problem; each failure is fed back to the model with the judge's output
MAX_ATTEMPTS=4
# Most problems handed to the model per day, including failures
MAX_TRIES_PER_DAY=10
# Only pick these difficulties: any of easy,medium,hard (empty = any).
# A 4B-8B model rarely solves hard problems.
DIFFICULTY=easy,medium
